# Mindspace API — production environment
#
# Copy to .env on your production server, or set these as environment variables
# in your hosting platform (Fly.io, Render, Railway, etc.).
#
# Generate JWT and encryption secrets with:
#   npx tsx scripts/generate-secrets.ts

NODE_ENV=production
PORT=4000

# ---------------------------------------------------------------------------
# Database & cache
# ---------------------------------------------------------------------------
# A managed Postgres 16+ instance (e.g. Supabase, AWS RDS, Neon).
DATABASE_URL=postgresql://mindspace:CHANGE_ME@your-host:5432/mindspace

# A managed Redis instance (e.g. Upstash, AWS ElastiCache). Optional — the API
# runs without it, just slower and without rate limiting.
REDIS_URL=redis://your-redis-host:6379

# ---------------------------------------------------------------------------
# Security — REQUIRED, no defaults
# ---------------------------------------------------------------------------
# Run `npx tsx scripts/generate-secrets.ts` to generate these.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# AES-256-GCM key for mood/health data at rest (PRD §5.2). 64 hex chars.
MOOD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Content delivery
# ---------------------------------------------------------------------------
# Base URL where HLS manifests and artwork are hosted.
CDN_BASE_URL=https://cdn.yourdomain.com

# ---------------------------------------------------------------------------
# AI companion
# ---------------------------------------------------------------------------
# One of: anthropic | openai | google | deepseek | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# Self-hosted model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# In-app purchases (Step 5)
# ---------------------------------------------------------------------------
# Apple App Store Server API — shared secret from App Store Connect.
APPLE_SHARED_SECRET=

# Google Play Developer API — path to service account JSON key file.
# Alternatively, set GOOGLE_SERVICE_ACCOUNT_JSON with the JSON content inline.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# ---------------------------------------------------------------------------
# Therapy sessions
# ---------------------------------------------------------------------------
# Jitsi Meet instance for video. Self-host for privacy.
VIDEO_BASE_URL=https://meet.jit.si
